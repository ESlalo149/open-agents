#!/bin/sh
set -e

echo "🔍 Type-checking..."
npm run check-types

# Catch generated-file drift locally instead of only in CI. Regenerate the
# AsyncAPI bindings, then fail if they differ from what's committed. On drift
# the generated file is left regenerated
# in the working tree -- just commit them and push again.
echo "🔍 Checking generated-file drift (AsyncAPI bindings)..."
npm run asyncapi:generate
if ! git diff --exit-code core/src/messages.ts; then
  echo "❌ Generated AsyncAPI types were out of date and have been regenerated above."
  echo "   Commit core/src/messages.ts, then push again."
  exit 1
fi
